default_platform(:ios)

APP_IDENTIFIER = "com.kent.quiz.samgukMaster"
APP_VERSION    = "1.0.1"
API_KEY_ID     = "33P5W93GJQ"
API_ISSUER_ID  = "ed28e2d3-ce1d-4d24-8e58-373132e4b554"
API_KEY_PATH   = File.expand_path("AuthKey_33P5W93GJQ.p8", __dir__)
APPLE_ID       = "sukhaverse@gmail.com"
TEAM_ID        = "KUDC7C6Z9H"
FLUTTER_ENV    = "env -u GEM_HOME -u GEM_PATH -u RUBYOPT -u RUBYLIB -u BUNDLE_BIN_PATH -u BUNDLE_GEMFILE"

platform :ios do
  desc "App Store Connect에 앱 등록"
  lane :create_app do
    produce(
      username: APPLE_ID,
      app_identifier: APP_IDENTIFIER,
      app_name: "Three Kingdoms Quiz",
      language: "en-US",
      app_version: APP_VERSION,
      sku: APP_IDENTIFIER,
      platforms: ["ios"],
      team_id: TEAM_ID
    )
  end

  desc "App Store 메타데이터 + 스크린샷 업로드 (심사 제출 X)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_app_version_update: false,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "1.0.0 빌드 attach + 카테고리 + 연령 등급 + 컨텐츠 권리 + 가격 자동 설정"
  lane :finalize_app_store do
    require 'spaceship'

    api_key = Spaceship::ConnectAPI::Token.create(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      filepath: API_KEY_PATH
    )
    Spaceship::ConnectAPI.token = api_key
    client = Spaceship::ConnectAPI::Tunes::Client.new(token: api_key)

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    v = app.get_app_store_versions.find do |x|
      x.version_string == APP_VERSION && x.app_store_state == 'PREPARE_FOR_SUBMISSION'
    end
    UI.user_error!("No PREPARE_FOR_SUBMISSION version 1.0.0") unless v

    # 1. Build attach
    builds = app.get_builds(filter: { 'preReleaseVersion.version' => APP_VERSION }, sort: '-version')
    latest = builds.find { |b| b.processing_state == 'VALID' }
    if latest
      v.select_build(build_id: latest.id)
      UI.success("Build #{latest.version} attached to #{APP_VERSION}")
    else
      UI.important("No VALID build to attach")
    end

    # 2. Category
    app_info = app.fetch_edit_app_info
    app_info.update_categories(category_id_map: {
      primary_category_id: 'GAMES',
      primary_subcategory_one_id: 'GAMES_TRIVIA'
    })
    UI.success("Categories: GAMES → GAMES_TRIVIA")

    # 3. Age Rating
    decl = app_info.fetch_age_rating_declaration
    Spaceship::ConnectAPI.patch_age_rating_declaration(
      age_rating_declaration_id: decl.id,
      attributes: {
        alcoholTobaccoOrDrugUseOrReferences: 'NONE', contests: 'NONE', gamblingSimulated: 'NONE',
        gunsOrOtherWeapons: 'NONE', horrorOrFearThemes: 'NONE', matureOrSuggestiveThemes: 'NONE',
        medicalOrTreatmentInformation: 'NONE', profanityOrCrudeHumor: 'NONE',
        sexualContentGraphicAndNudity: 'NONE', sexualContentOrNudity: 'NONE',
        violenceCartoonOrFantasy: 'INFREQUENT_OR_MILD',
        violenceRealisticProlongedGraphicOrSadistic: 'NONE', violenceRealistic: 'NONE',
        advertising: true, ageAssurance: false, gambling: false,
        healthOrWellnessTopics: false, lootBox: false, messagingAndChat: false,
        parentalControls: false, unrestrictedWebAccess: false, userGeneratedContent: false,
        ageRatingOverride: 'NONE', koreaAgeRatingOverride: 'NONE'
      }
    )
    UI.success("Age Rating set")

    # 4. Content Rights Declaration
    Spaceship::ConnectAPI.patch_app(
      app_id: app.id,
      attributes: { contentRightsDeclaration: 'DOES_NOT_USE_THIRD_PARTY_CONTENT' }
    )
    UI.success("Content Rights: DOES_NOT_USE_THIRD_PARTY_CONTENT")

    # 5. Pricing — Free
    pps = client.get("v1/apps/#{app.id}/appPricePoints?filter[territory]=USA&limit=200").body['data'] || []
    free_pp = pps.find { |p| p['attributes']['customerPrice'].to_f == 0.0 }
    if free_pp
      begin
        client.post("v1/appPriceSchedules", {
          data: {
            type: 'appPriceSchedules',
            relationships: {
              app: { data: { type: 'apps', id: app.id } },
              manualPrices: { data: [{ type: 'appPrices', id: '${free}' }] },
              baseTerritory: { data: { type: 'territories', id: 'USA' } }
            }
          },
          included: [{
            type: 'appPrices',
            id: '${free}',
            attributes: {},
            relationships: {
              appPricePoint: { data: { type: 'appPricePoints', id: free_pp['id'] } }
            }
          }]
        })
        UI.success("Pricing: Free")
      rescue => e
        UI.important("Pricing skipped (likely already set): #{e.message[0..100]}")
      end
    end

    UI.message("─" * 60)
    UI.important("⚠️  남은 수동 작업 (Apple API 비공개 — App Store Connect 웹에서):")
    UI.important("   1. App Privacy — 데이터 수집 항목 답변 (IDFA / User ID)")
    UI.important("   2. Game Center — 리더보드/업적 구성 (games_services 사용 중)")
    UI.important("   3. Submit for Review 클릭")
  end

  desc "TestFlight 배포"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    begin
      build_num = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER
      ) + 1
    rescue
      build_num = 1
    end

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/Runner.xcodeproj",
      team_id: TEAM_ID
    )

    sh("cd .. && #{FLUTTER_ENV} flutter pub get")
    sh("cd .. && #{FLUTTER_ENV} flutter build ipa --release --build-name #{APP_VERSION} --build-number #{build_num} --export-options-plist=fastlane/ios_export.plist")

    ipa = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].max_by { |path| File.mtime(path) }
    UI.user_error!("IPA not found in build/ios/ipa") unless ipa

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
